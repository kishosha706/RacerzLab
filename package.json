{
  "name": "racelab-garage-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup:python": "powershell -ExecutionPolicy Bypass -File scripts/setup_python.ps1",
    "api": "uvicorn api.main:app --reload --host 127.0.0.1 --port 8010",
    "test": "pytest",
    "ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "typecheck:ui": "cd ui && npm run typecheck",
    "desktop": "powershell -ExecutionPolicy Bypass -File scripts/start_desktop.ps1",
    "tauri:dev": "npm --prefix ui run tauri:dev",
    "tauri:build": "npm --prefix ui run tauri:build"
  }
}
