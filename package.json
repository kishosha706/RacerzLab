{
  "name": "racelab-garage-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "setup:python": "powershell -ExecutionPolicy Bypass -File scripts/setup_python.ps1",
    "api": "uvicorn api.main:app --reload --host 127.0.0.1 --port 8010",
    "test": "pytest",
    "check:python": "python -m ruff check . && python -m pytest -q",
    "check:ui": "npm --prefix ui test -- --run && npm run typecheck:ui && npm run ui:build",
    "check:e2e": "npm --prefix ui run test:e2e",
    "check:desktop": "cargo check --manifest-path ui/src-tauri/Cargo.toml --locked",
    "check:api-contract": "npm --prefix ui run generate:api-types && git diff --exit-code -- docs/contracts/openapi.generated.json ui/src/types/openapi.generated.d.ts",
    "check": "npm run check:python && npm run check:ui",
    "ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "typecheck:ui": "cd ui && npm run typecheck",
    "desktop": "powershell -ExecutionPolicy Bypass -File scripts/start_desktop.ps1",
    "tauri:dev": "npm --prefix ui run tauri:dev",
    "tauri:build": "npm --prefix ui run tauri:build"
  }
}
